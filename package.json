{
	"name": "unbg",
	"version": "0.0.0-semantic-release",
	"description": "Strip a solid background to transparency using difference matting between two images",
	"keywords": [
		"background removal",
		"transparent",
		"alpha",
		"matting",
		"difference matting",
		"chroma key",
		"png",
		"jpeg",
		"webp",
		"image",
		"wasm",
		"cli"
	],
	"license": "MIT",
	"repository": "privatenumber/unbg",
	"funding": "https://github.com/privatenumber/unbg?sponsor=1",
	"author": {
		"name": "Hiroki Osame",
		"email": "hiroki.osame@gmail.com"
	},
	"files": [
		"dist",
		"skills"
	],
	"type": "module",
	"bin": "./dist/cli/index.mjs",
	"exports": {
		".": {
			"types": "./dist/node/index.d.mts",
			"default": "./dist/node/index.mjs"
		},
		"./core": {
			"types": "./dist/core/index.d.mts",
			"default": "./dist/core/index.mjs"
		}
	},
	"packageManager": "pnpm@10.20.0",
	"scripts": {
		"build": "pkgroll",
		"cli": "node src/cli/index.ts",
		"web:dev": "pnpm --filter web dev",
		"lint": "lintroll --cache --git --node",
		"test": "node tests/index.ts",
		"type-check": "tsc",
		"prepack": "pnpm build && clean-pkg-json",
		"prepare": "skills-npm"
	},
	"engines": {
		"node": ">=22.22.2"
	},
	"dependencies": {
		"@jsquash/jpeg": "^1.6.0",
		"@jsquash/png": "^3.1.1",
		"@jsquash/webp": "^1.5.0",
		"cleye": "3.0.0-beta.1"
	},
	"devDependencies": {
		"@types/node": "^25.5.0",
		"clean-pkg-json": "^2.0.0",
		"fs-fixture": "^2.14.0",
		"lintroll": "^1.31.1",
		"manten": "^2.0.2",
		"pkgroll": "^2.27.1",
		"skills-npm": "^1.2.0",
		"typescript": "^6.0.2"
	}
}
