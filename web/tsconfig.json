{
	"compilerOptions": {
		"target": "ESNext",
		"lib": [
			"ESNext",
			"DOM",
			"DOM.Iterable",
		],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"types": [
			"node",
		],
		"allowImportingTsExtensions": true,
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
	},
	"include": [
		"src",
		"vite.config.ts",
		"env.d.ts",
	],
}
